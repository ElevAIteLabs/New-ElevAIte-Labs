# Base URL of the PHP API. Copy this file to .env before building.
# Production (site and API are served from the same origin):
VITE_API_URL=https://elevaitelabs.in/api

# A relative path also works and avoids hardcoding the domain:
# VITE_API_URL=/api

# GA4 measurement ID, from Admin -> Data Streams -> the web stream.
# Not a secret - it ships in the HTML of every page - but it is kept out of
# git so a clone does not report into someone else's property.
#
# Leave it unset and the build simply ships no tag. Set it and vite.config.js
# injects the tag into every page, including the prerendered ones. Analytics
# was previously lost because the tag lived only in the server's copy of
# index.html, so the next deploy overwrote it.
VITE_GA_ID=G-XXXXXXXXXX
