Options -Indexes
DirectoryIndex index.html

# Anything that is not meant to be served must stay unreadable whatever
# extension it ends up with. api/config.php is safe only because its mode is
# 0600; a backup copy of it written into the same folder inherited 0644 and
# was served as plain text, credentials and all, until it was removed.
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(bak|bak-[A-Za-z0-9]+|orig|save|swp|sql|env|ini|log|sh|zip|tar|gz|old)$|^config\.php)">
    Require all denied
  </FilesMatch>
</IfModule>

# Without this, mod_dir 301-redirects /services to /services/ before the
# rewrite below can serve the prerendered file, adding a hop to every page.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0a. Force one hostname. Search Console showed the site indexed on both
  #     www and apex - www/blog-kredoo alone had 44 impressions - which
  #     splits ranking signals across two copies of every page. The canonical
  #     tag alone was not enough; a 301 is unambiguous. Must run first.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 0b. URLs from the previous static site that still hold impressions.
  #     /contacts and /careers were both ranking around position 1 and began
  #     returning 404 once real 404s were introduced, so they are redirected
  #     to their nearest equivalent rather than lost.
  RewriteRule ^contacts/?$ /contact [R=301,L]
  RewriteRule ^careers/?$ /about [R=301,L]

  # 0c. The old site served .html URLs. Map them onto the current routes.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^(about|services|work|products|learn|contact)\.html$ /$1 [R=301,L]
  RewriteRule ^(blog-automation|blog-kredoo|blog-whatsapp)\.html$ /$1 [R=301,L]

  # 1. Serve the prerendered HTML for a route when one exists.
  #    Matched without a trailing-slash redirect so /services stays /services.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^.]+?)/?$ /$1/index.html [L]

  # 2. Real files and directories (assets, pictures, /api/*.php) pass through.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Admin is deliberately client-rendered. It gets the bare noindex shell,
  #    not index.html - that now holds the prerendered homepage, which would
  #    make every /admin URL look like a duplicate of /.
  RewriteRule ^admin(/.*)?$ /app-shell.html [L]

  # 4. Anything else genuinely does not exist. Previously every unknown URL
  #    fell through to index.html and returned 200, so the whole domain
  #    produced soft-404s - Google indexed /careers, which was never a route.
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# Hashed build assets are immutable; HTML must stay revalidated.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
