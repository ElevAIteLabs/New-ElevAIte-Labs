# Credentials handed over by file rather than pasted into chat. They live in
# the working tree for minutes at a time, which is long enough for a stray
# `git add .` to commit one - this repo is public, so that is unrecoverable.
openai.txt
apppw.txt
webhook.txt
*-secret.txt
*.key

# Assembled upload payload produced by `npm run build:deploy`
deploy/

# Downloaded copy of the live server root
public_html/

# Playwright/browser test artifacts
.playwright-mcp/

# PHPMailer is committed so a clean clone can deploy without composer.

# Search Console exports - local analysis only, not for a public repo
elevaitelabs.in-Performance-on-Search-*/
*-Performance-on-Search-*/

# Build artefact - 91MB, and rebuildable with `npm run build:deploy`
deploy.zip

# Search Console / Analytics exports - business data, not for a public repo
analytics/
